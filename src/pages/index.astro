<style lang="scss">

  @keyframes ninja {
    from {
      transform: scale(1.1) translateY(-10%);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }


  #logo-ninja {
    margin: 4.8rem;
    width: 90%; max-width: 60ch;
    outline: none;

    #unseen-letter-u, #unseen-letter-n1, #unseen-letter-s,
    #unseen-letter-e1, #unseen-letter-e2, #unseen-letter-n2,
    #unseen-semicolon { fill: url(#gradient-lemon); }

    #text     { fill: url(#gradient-raspberry); }
    #outline  { fill: var(--lychee-tint); }
    #shadow   { fill: var(--black); }
  }


  @media (prefers-reduced-motion) {
    #logo-ninja,
    #logo-ninja * { animation: none; }
  }


  #logo-ninja #shadow,
  #logo-ninja #text,
  #logo-ninja #outline {
    transform: scale(1.1); transform-origin: center center;
    animation: ninja 300ms ease-out forwards;
    opacity: 0;
  }



  @keyframes unseen {
    from {
      transform: translateY(3%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }


  #logo-ninja #shadow  { animation-delay: 500ms; }
  #logo-ninja #text    { animation-delay: 650ms; }
  #logo-ninja #outline { animation-delay: 800ms; }


  #unseen > * {
    transform: translateY(3%); transform-origin: center center;
    animation: unseen 750ms ease-in forwards;
    opacity: 0;
  }


  #logo-ninja #unseen-letter-u  { animation-delay: 1300ms; }
  #logo-ninja #unseen-letter-n1 { animation-delay: 1400ms; }
  #logo-ninja #unseen-letter-s  { animation-delay: 1500ms; }
  #logo-ninja #unseen-letter-e1 { animation-delay: 1600ms; }
  #logo-ninja #unseen-letter-e2 { animation-delay: 1700ms; }
  #logo-ninja #unseen-letter-n2 { animation-delay: 1800ms; }
  #logo-ninja #unseen-semicolon { animation-delay: 1900ms; }

</style>
