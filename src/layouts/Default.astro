---
import Skeleton from "@layouts/_Skeleton.astro";
---



<Skeleton>

  {/* This line propagates the OpenGraph data to the Skeleton's <head> */}
  <slot name="head:metadata" slot="head:metadata" />

  <main>
    <slot />
  </main>

</Skeleton>



<style lang="scss">

  @use "@styles/globals.scss" as *;


  main {
    margin: var(--body-padding); padding-block-end: calc(var(--body-padding) * 2);

    @media (width > $mobile-breakpoint) {
      margin-inline: auto; padding-inline-end: var(--body-padding); padding-block-end: 0;
      max-width: 80ch; min-height: calc(100dvh - var(--body-padding) * 2);
    }
  }

</style>
